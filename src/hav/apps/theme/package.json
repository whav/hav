{
  "name": "hav-theme",
  "version": "1.0.0",
  "description": "Frontend assets (tailwind css, leaflet) of the hav stack.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n tailwind,leaflet \"npm:dev:tw\" \"npm:export_deps:leaflet\"",
    "build": "concurrently -n tailwind,leaflet \"npm:build:tw\" \"npm:export_deps:leaflet\"",
    "dev:tw": "tailwindcss --postcss --watch --jit -i ./src/tailwind/styles.css -o ./static/theme/styles.css",
    "build:tw": "NODE_ENV=production tailwindcss --postcss --jit -i ./src/tailwind/styles.css -o ./static/theme/styles.css",
    "export_deps:leaflet": "/bin/sh -c 'cp -r node_modules/leaflet/dist/images static/theme/ && cp node_modules/leaflet/dist/leaflet.js node_modules/leaflet/dist/leaflet.js.map static/theme/ && cp src/content/content.js static/theme/'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "leaflet": "^1.7.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5",
    "@tailwindcss/typography": "^0.5",
    "autoprefixer": "^10.3.1",
    "concurrently": "^6.2.1",
    "postcss": "^8.3.6",
    "postcss-import": "^14.0.2",
    "prettier": "2.3.2",
    "tailwindcss": "^3.0"
  }
}
